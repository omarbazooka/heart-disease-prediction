{
  "info": {
    "name": "Heart Disease Prediction - Admin & Seed",
    "_postman_id": "hd-prediction-api-2026-admin-seed",
    "description": "Seed & admin utilities for backend testing.\nBackend: http://localhost:5000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "admin_key", "value": "", "type": "string" },
    { "key": "lab_key", "value": "admin-key-change-me", "type": "string" },
    { "key": "lab_id", "value": "", "type": "string" },
    { "key": "hospital_id", "value": "", "type": "string" },
    { "key": "prediction_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth (admin)",
      "item": [
        {
          "name": "Login (admin user)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.token) {",
                  "  pm.environment.set('token', json.token);",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}",
                  "console.log(json);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Labs (seed/admin)",
      "item": [
        {
          "name": "Create Lab",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"lab_code\": \"\",\n  \"address\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/labs",
              "host": ["{{base_url}}"],
              "path": ["api", "labs"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201 && json.data?.id) {",
                  "  pm.environment.set('lab_id', json.data.id);",
                  "  pm.collectionVariables.set('lab_id', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Labs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/labs?page=1&limit=100",
              "host": ["{{base_url}}"],
              "path": ["api", "labs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "100" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Hospitals (seed/admin)",
      "item": [
        {
          "name": "Create Hospital (admin key required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-admin-key", "value": "{{admin_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"area\": \"\",\n  \"google_maps_link\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/hospitals",
              "host": ["{{base_url}}"],
              "path": ["api", "hospitals"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201 && json.data?.id) {",
                  "  pm.environment.set('hospital_id', json.data.id);",
                  "  pm.collectionVariables.set('hospital_id', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Hospitals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/hospitals?page=1&limit=100",
              "host": ["{{base_url}}"],
              "path": ["api", "hospitals"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "100" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "LabTests (bulk/admin)",
      "item": [
        {
          "name": "Upload CSV (bulk)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-lab-key", "value": "{{lab_key}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/lab-portal/upload-csvs",
              "host": ["{{base_url}}"],
              "path": ["api", "lab-portal", "upload-csvs"]
            }
          }
        },
        {
          "name": "Upload Single CSV",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-lab-key", "value": "{{lab_key}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/lab-portal/upload-csv",
              "host": ["{{base_url}}"],
              "path": ["api", "lab-portal", "upload-csv"]
            }
          }
        },
        {
          "name": "Get All LabTests",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/labtests?page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "labtests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Predictions (gateway)",
      "item": [
        {
          "name": "Start Prediction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/predictions/start",
              "host": ["{{base_url}}"],
              "path": ["api", "predictions", "start"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201 && json.data?.prediction_id) {",
                  "  pm.environment.set('prediction_id', json.data.prediction_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get SHAP",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/predictions/{{prediction_id}}/shap",
              "host": ["{{base_url}}"],
              "path": ["api", "predictions", "{{prediction_id}}", "shap"]
            }
          }
        },
        {
          "name": "Get Report",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/predictions/{{prediction_id}}/report",
              "host": ["{{base_url}}"],
              "path": ["api", "predictions", "{{prediction_id}}", "report"]
            }
          }
        }
      ]
    },
    {
      "name": "Users (debug)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        }
      ]
    }
  ]
}