# PostgreSQL (Neon) — required
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

PORT=5000
NODE_ENV=development

# JWT — required (gateway signs tokens for the frontend)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# Internal AI service (FastAPI) — Node is the only caller; keep key secret and identical on AI .env
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=change-me-internal-ai-key-shared-with-fastapi
AI_REQUEST_TIMEOUT_MS=120000

# CORS: set to your frontend origin in production, or omit for permissive dev
# CORS_ORIGIN=http://localhost:3000

# Rate limit: max requests per IP per window (see server.js)
# RATE_LIMIT_MAX=300

# LOG_LEVEL=info






# Admin operations (hospitals seed) — x-admin-key header
ADMIN_API_KEY=change-me-admin-key

# Lab CSV ingest (Postman / lab portal) — x-lab-key header; falls back to ADMIN_API_KEY when unset
LAB_API_KEY=change-me-lab-ingest-key





