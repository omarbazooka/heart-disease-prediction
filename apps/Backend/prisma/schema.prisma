generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  national_id String   @unique
  username    String
  email       String   @unique
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  predictions Prediction[]
  ecgTests    EcgTest[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Lab {
  id        String    @id @default(cuid())
  name      String
  lab_code  String    @unique
  address   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  labTests  LabTest[]
  ecgTests  EcgTest[]

  @@map("labs")
}

model LabTest {
  id                    String   @id @default(cuid())
  lab_id                String
  national_id           String
  age                   Float
  sex                   Int
  chest_pain_type       Int
  resting_bp_s          Float
  cholesterol           Float
  fasting_blood_sugar   Int
  resting_ecg           Int
  max_heart_rate        Float
  exercise_angina       Int
  oldpeak               Float
  st_slope              Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  lab                   Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  prediction            Prediction?

  @@index([national_id])
  @@map("lab_tests")
}

model Prediction {
  id                    String   @id @default(cuid())
  user_id               String?
  lab_test_id           String   @unique
  prediction_result     Int?     
  prediction_percentage Float?
  risk_level            String?
  decision              String?
  shap_image            Bytes?
  shap_values_json      Json?
  llm_report_json       Json?
  pdf_binary            Bytes?
  report_generated_at   String?
  createdAt             DateTime? @default(now())
  updatedAt             DateTime? @updatedAt
  
  labTest               LabTest  @relation(fields: [lab_test_id], references: [id], onDelete: Cascade)
  user                  User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("predictions")
}

model Hospital {
  id               String   @id @default(cuid())
  name             String
  area             String
  google_maps_link String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("hospitals")
}

/// WFDB ECG uploads and AI pipeline results (separate from lab_tests / predictions).
model EcgTest {
  id                    String    @id @default(cuid())
  lab_id                String
  national_id           String
  user_id               String?

  dat_file_path         String?
  hea_file_path         String?
  original_dat_name     String?
  original_hea_name     String?
  storage_backend       String    @default("local")
  file_size_bytes       Int?
  checksum_dat          String?
  checksum_hea          String?

  primary_diagnosis     String?
  primary_probability   Float?
  detailed_results_json Json?

  model_name            String?
  model_version         String?
  inference_status      String    @default("pending")
  inference_error       String?
  inferred_at           DateTime?

  llm_ecg_json          Json?
  llm_model             String?
  llm_prompt_version    String?

  prediction_completed_at DateTime?

  uploaded_by           String    @default("lab_portal")
  client_request_id     String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lab                   Lab       @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  user                  User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([national_id, createdAt])
  @@index([lab_id])
  @@map("ecg_tests")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
